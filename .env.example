# Copy to .env to override defaults. All values are optional.

# HTTP/WebSocket server
AV_HOST=127.0.0.1
AV_PORT=3001
# Extra origins allowed to open the Playground WebSocket (comma-separated).
# AV_ALLOWED_ORIGINS=https://example.com

# Sandbox
AV_DOCKER_BIN=docker
AV_SANDBOX_IMAGE=algoviz-sandbox:latest
# Host directory for compiled binaries (bind-mounted read-only into containers).
# AV_WORK_DIR=/tmp/algoviz
AV_MAX_SANDBOXES=8

# Limits applied to every user program
AV_CPU_SECONDS=5
AV_WALL_SECONDS=30
AV_MEMORY_MB=256
AV_PIDS=64
AV_OUTPUT_KB=256
AV_SOURCE_KB=64
AV_DEBUG_IDLE_SECONDS=600
